{
  "name": "smart-video-transcript-capture",
  "version": "0.3.0",
  "description": "Local-first desktop video transcription app for Windows",
  "main": "electron/main.cjs",
  "author": "prayer168",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/correction.cjs && node --check dist/app.js",
    "test": "node --test tests/correction.test.cjs",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tw.prayer168.smartvideotranscript",
    "productName": "智慧影片逐字稿",
    "artifactName": "Smart-Video-Transcript-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Smart-Video-Transcript-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智慧影片逐字稿"
    }
  }
}
